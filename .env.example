NODE_ENV=development
PORT=3000
API_VERSION=v1
MONGODB_URI=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@zonerlost.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ca-central-1
AWS_S3_BUCKET=zonerlost-media
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
OTP_EXPIRES_IN_MINUTES=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
REVENUECAT_API_KEY=

# ── Payouts (Stripe Connect) ───────────────────────────────────────────────
# Owners onboard with Stripe, so no bank details are ever stored in this database.
# With no secret key the payout endpoints answer 503 instead of pretending to work.
STRIPE_SECRET_KEY=
# Not a secret: served to clients by GET /payments/config so a key change needs no app release.
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Country of the connected accounts we create. Owners are in Quebec, so ca.
STRIPE_CONNECT_ACCOUNT_COUNTRY=ca
# Where Stripe returns the owner after hosted onboarding. **http(s) only** — Stripe refuses a custom
# scheme with "Not a valid URL", so an app deep link cannot go here. Leave both empty and onboarding
# lands on this server's /payouts pages, which is the supported path; set them only for a real
# https universal/app link.
STRIPE_CONNECT_RETURN_URL=
STRIPE_CONNECT_REFRESH_URL=
# The app's own scheme. Not sent to Stripe — the /payouts pages redirect here, which is how the owner
# gets back into the app from a flow that can only end on https.
APP_PAYOUT_RETURN_DEEPLINK=atussa://payouts/done
APP_PAYOUT_REFRESH_DEEPLINK=atussa://payouts/retry

# Without this the RevenueCat webhook skips its signature check entirely.
REVENUECAT_WEBHOOK_SECRET=

# Geocoding. The default provider needs no key; set GEOCODER=mapbox|google with a key for volume.
# A wrong coordinate is worse than none, so changing the provider means re-reading the dry run of
# scripts/backfill-location-geo.cjs --geocode. See the Location section of CLAUDE.md.
GEOCODER=nominatim
GEOCODER_API_KEY=
GEOCODER_USER_AGENT=Atussa/1.0 (support@atussa.ca)

# Timed work (boost expiry, and soon deposit release and owner payouts).
# Defaults to on when NODE_ENV=production and off otherwise, so a dev machine pointed at the
# production cluster does not run production jobs. Set explicitly to override.
SCHEDULER_ENABLED=
SCHEDULER_TICK_MS=60000

# Pricing. 2026-09 is the live model (15% commission + 3%/$3.99 renter fee); 2026-11 is the new
# one (15% commission + 15% renter markup, no fee). DO NOT switch to 2026-11 until the client
# confirms the GST/QST base in writing - see the header of src/helpers/pricing.helper.ts.
PRICING_MODEL=2026-09

# How the renter is charged, and therefore when the owner is paid.
#   destination = destination charge; the owner's share leaves at capture (live today)
#   platform    = separate charges and transfers; the release-owner-payouts job pays the owner
# Do NOT set this to platform until one owner has reached "active" on Stripe onboarding and a real
# transfer has been verified: no owner has completed onboarding, so the transfers capability is
# unproven. A payment records which model charged it, so switching never affects anything already
# charged.
STRIPE_CHARGE_MODEL=destination

# Hours after a rental ends before the owner's share is transferred. Matches the 24-hour claim
# window, so the payout cannot land before a claim could be opened against it.
OWNER_PAYOUT_HOLD_HOURS=24
# Only read under 2026-11: fees_only | renter_total. Neither reading is confirmed.
PRICING_TAX_BASE=fees_only
